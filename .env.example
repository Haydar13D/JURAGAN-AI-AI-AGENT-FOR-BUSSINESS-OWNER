# JuraganAI Environment Configuration
APP_NAME=JuraganAI
APP_ENV=development
HOST=0.0.0.0
PORT=8005
DEBUG=True

# Database Configuration (PostgreSQL or SQLite fallback)
# For local Docker PostgreSQL: postgresql+asyncpg://juragan:juragansecret@localhost:5436/juragan_ai
# For zero-config standalone local dev: sqlite+aiosqlite:///./juragan_ai.db
DATABASE_URL=sqlite+aiosqlite:///./juragan_ai.db

# LLM Provider Configuration
LLM_PROVIDER=deepseek # Options: deepseek, openrouter

# Primary Provider (DeepSeek API)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Alternative Provider (OpenRouter API)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_DEFAULT_CHAT_ID=

# Business & Reporting Configuration
DEFAULT_OUTLET_ID=1
DAILY_REPORT_CRON_HOUR=22
DAILY_REPORT_CRON_MINUTE=30
TIMEZONE=Asia/Jakarta
